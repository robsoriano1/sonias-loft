# Copy this file to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Use whichever your Supabase project shows:
#   older projects: the "anon public" key   -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   newer projects: the "publishable" key   -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx


# ---------------------------------------------------------------------------
# EMAIL  (required for owner notifications and guest confirmations)
#
# With no provider key the site still works and enquiries are still saved -
# nothing is sent, and the dashboard says so.
#
# Pick ONE. If more than one is set, Gmail wins, then SendGrid, then Resend.
#
#   Gmail     - FREE, no domain needed. The site logs into a Gmail account and
#               sends as it. In that Google account:
#                 1. Turn on 2-Step Verification.
#                 2. Go to myaccount.google.com/apppasswords and create one
#                    (call it "Sonia's Loft website").
#                 3. Paste the 16 letters below - spaces are fine.
#               Mail shows up in that account's Sent folder, and guests'
#               replies land in its inbox. Changing the account's main
#               password cancels the app password; make a new one if so.
#
#   SendGrid  - NOT free any more: a 60-day trial, then $19.95/month or
#               sending stops. Verifies a single ordinary address.
#
#   Resend    - free tier, but requires a verified DOMAIN. Best end state
#               once you own one: mail comes from your own name, with DKIM
#               and SPF.
# ---------------------------------------------------------------------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Force a provider when several are set. Usually leave this unset.
# MAIL_PROVIDER=gmail

# The sender, for SendGrid and Resend only - Gmail always sends as GMAIL_USER
# and ignores this. It MUST be an address your provider has verified, or every
# send is rejected.
#   SendGrid:  Sonia's Loft <you@gmail.com>
#   Resend:    Sonia's Loft <bookings@yourdomain.com>
# Exactly one pair of angle brackets - a stray one rejects every send.
# NOTIFY_FROM=Sonia's Loft <bookings@yourdomain.com>

# Fallback address for new-enquiry alerts. The address set in
# Owner -> Settings wins over this one.
NOTIFY_TO=sonia@example.com

# Used for the "Open the dashboard" link inside notification emails, and for
# the iCal feed address shown in the admin. Falls back to site.url.
NEXT_PUBLIC_SITE_URL=https://soniasloft.com


# ---------------------------------------------------------------------------
# CALENDAR SHARING  (optional)
#
# A long random string. Anyone holding it can read when the loft is booked,
# so treat it like a password. Leave unset and the iCal feed stays switched
# off entirely. Generate one with:  openssl rand -hex 24
# ---------------------------------------------------------------------------
ICAL_TOKEN=


# ---------------------------------------------------------------------------
# SCHEDULED REVIEW NUDGES  (optional)
#
# The daily job that emails guests after checkout. It runs with nobody signed
# in, so it needs the service-role key - NEVER expose this to the browser and
# never prefix it with NEXT_PUBLIC_. Leave both unset and the job stays off;
# the owner can still send each nudge by hand from the booking screen.
#
# CRON_SECRET is generated for you by Vercel when you add a cron job.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
