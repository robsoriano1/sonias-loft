# Copy this file to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Use whichever your Supabase project shows:
#   older projects: the "anon public" key   -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   newer projects: the "publishable" key   -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx


# ---------------------------------------------------------------------------
# EMAIL  (required for owner notifications and guest confirmations)
#
# Without RESEND_API_KEY the site still works and enquiries are still saved -
# nothing is sent, and the dashboard says so. Get a key at resend.com.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx

# A sender Resend has verified for your domain. Until you verify one, Resend's
# shared onboarding@resend.dev works for testing.
NOTIFY_FROM=Sonia's Loft <bookings@soniasloft.com>

# Fallback address for new-enquiry alerts. The address set in
# Owner -> Settings wins over this one.
NOTIFY_TO=sonia@example.com

# Used for the "Open the dashboard" link inside notification emails, and for
# the iCal feed address shown in the admin. Falls back to site.url.
NEXT_PUBLIC_SITE_URL=https://soniasloft.com


# ---------------------------------------------------------------------------
# CALENDAR SHARING  (optional)
#
# A long random string. Anyone holding it can read when the loft is booked,
# so treat it like a password. Leave unset and the iCal feed stays switched
# off entirely. Generate one with:  openssl rand -hex 24
# ---------------------------------------------------------------------------
ICAL_TOKEN=


# ---------------------------------------------------------------------------
# SCHEDULED REVIEW NUDGES  (optional)
#
# The daily job that emails guests after checkout. It runs with nobody signed
# in, so it needs the service-role key - NEVER expose this to the browser and
# never prefix it with NEXT_PUBLIC_. Leave both unset and the job stays off;
# the owner can still send each nudge by hand from the booking screen.
#
# CRON_SECRET is generated for you by Vercel when you add a cron job.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
